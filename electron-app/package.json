{
  "name": "electron-app",
  "productName": "Realtime GraReco & Search",
  "version": "1.0.2",
  "license": "Apache-2.0",
  "description": "Realtime GraReco & Search - Desktop App",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run notices && electron-vite build",
    "notices": "node ../scripts/third-party-notices.mjs --app . --out build/THIRD_PARTY_NOTICES.txt",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config",
    "test": "vitest run test/unit"
  },
  "thirdPartyNotices": {
    "include": [
      "react",
      "react-dom",
      "@electron-toolkit/utils"
    ],
    "includeWithoutDeps": [
      "electron",
      "vite",
      "tailwindcss"
    ],
    "notes": [
      "Electron に含まれる Chromium などのライセンスは、アプリに同梱の LICENSES.chromium.html にあります。"
    ]
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  }
}
