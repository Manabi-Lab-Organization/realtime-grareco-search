# このファイルを .env という名前でコピーして、値を書き込んでください（cp .env.example .env）。
# 書き方の詳しい説明は docs/setup.md にあります。
# .env にはキーやパスワードが入ります。ほかの人が読めない場所に置き、Git に入れないでください。

# ===== 必須 =====

# 利用者が開くこのサーバのアドレス。https から書く（例: https://grareco.example.com）
APP_URL=

# ログインの情報を守るための長いでたらめな文字列。openssl rand -hex 32 の結果を貼る
SESSION_SECRET=

# データベースのパスワード。英数字だけにする（openssl rand -hex 24 の結果がおすすめ）
# 最初に立ち上げたあとは変えない（変えるとデータベースに繋がらなくなる）
POSTGRES_PASSWORD=

# 最初の管理者になる人のメールアドレス。このアドレスの人だけが最初に登録できる
INITIAL_ADMIN_EMAIL=

# 文字起こし（ElevenLabs）
ELEVENLABS_API_KEY=

# リアルタイム調査・グラレコの区切りの判定など（Anthropic）。Gemini が無いときは要約・議事録・用語解説も受け持つ
ANTHROPIC_API_KEY=

# ===== 入り口（https）=====

# 立ち上げ方 A（docker compose --profile https up -d）で使う。https の証明書を取るホスト名（例: grareco.example.com）
DOMAIN=

# アプリのポートをどこで待ち受けるか。既定は 127.0.0.1（このサーバの中からだけ）
# 別のサーバの入り口から転送するときや、http で直接開くときは 0.0.0.0
APP_BIND=
# 待ち受けるポート番号。既定は 3000
APP_PORT=

# 手前にある入り口（リバースプロキシ）の段数。既定は 1。2段なら 2、入り口を置かずに直接開くなら false
TRUST_PROXY=

# http で直接開くときだけ true（おすすめしない。docs/setup.md を参照）
ALLOW_HTTP=

# ===== 任意の AI キー =====

# 要約・議事録・用語解説・画像の読み取り・自動グラレコ・グラレコ検索（Google Gemini）
# 請求先を紐づけた有料枠のキーを使う。無料枠は送った内容が Google のサービス改善に使われることがある
GEMINI_API_KEY=

# 手動グラレコ・最終グラレコの作画（OpenAI）
OPENAI_API_KEY=

# 手動グラレコを OpenAI があっても Gemini で描きたいときだけ gemini
GRARECO_MANUAL_PROVIDER=

# ===== メール（任意）=====

# メールを送るためのキー（Resend）。無ければメールは送らない（パスワードを忘れた人には管理者が一時パスワードを出す）
RESEND_API_KEY=
# 送り主のアドレス。Resend で確認済みのドメインのアドレスにする（例: grareco@example.com）
FROM_EMAIL=
# グラレコの作画が OpenAI から Gemini に切り替わったときに知らせる先（運用担当のアドレス）
OPS_EMAIL=

# ===== Google ログイン（任意）=====

# Google Cloud で作った OAuth クライアント ID（ウェブ用）。設定するとログイン画面に Google ログインが出る
GOOGLE_CLIENT_ID=
# ===== 画面の表示（任意）=====

# 画面に出すアプリの名前（空なら Realtime GraReco & Search）
APP_NAME=
# 画面の下に出す組織の名前
ORGANIZATION_NAME=
# 困ったときのページに出す問い合わせ先のメールアドレス
SUPPORT_EMAIL=
# 利用規約とプライバシーポリシーのページのアドレス。設定するとログイン画面やアプリにリンクが出る
TERMS_URL=
PRIVACY_URL=

# ===== 任意の機能 =====

# 会議室のカメラ観察。true のときだけ動く。使う前に docs/room-observation.md を読む
ROOM_OBSERVATION_ENABLED=
# 会議中の「アシスタント」（試験的）。true のときだけ動く
ENABLE_NL_AGENT=
# リアルタイム調査を止めたいときだけ false
RESEARCH_ENABLED=

# ===== デスクトップアプリの配布（任意）=====

# GitHub のトークン（ふつうは空でよい）。空なら /download は GitHub の公開ページから直接落とす。
# 非公開のリポジトリから配る場合だけ、そのリポジトリを読める権限のトークンを入れる
GITHUB_RELEASES_TOKEN=
# アプリを取りに行くリポジトリ（空なら Manabi-Lab-Organization/realtime-grareco-search）
GITHUB_REPO=
# これより古いアプリの接続を断り、更新を促す（例: 1.2.0）。空なら制限しない
MIN_DESKTOP_VERSION=
MIN_MOBILE_VERSION=

# ===== 操作の記録の書き出し（任意）=====

# 4つともそろえると、操作の記録を 1日ごとに Cloudflare R2 へ書き出す。無ければデータベースの中にだけ残る
AUDIT_R2_ACCOUNT_ID=
AUDIT_R2_ACCESS_KEY_ID=
AUDIT_R2_SECRET_ACCESS_KEY=
AUDIT_R2_BUCKET=
# 書き出し先のフォルダ名に使う名前（空なら local）
AUDIT_R2_ENV=
# 書き出し済みの記録をデータベースに残す日数（365 以上。空なら 400）
AUDIT_DB_RETENTION_DAYS=

# ===== 細かい調整（ふつうは空のまま）=====

# ウェブ画面で操作がないときに自動でログアウトするまでの分（既定 60）
WEB_SESSION_IDLE_MINUTES=
# ウェブ画面でログインしてから必ずログアウトするまでの分（既定 720。0 で無制限）
WEB_SESSION_ABSOLUTE_MINUTES=
# 管理画面で操作がないときに自動でログアウトするまでの分（既定 15）
ADMIN_SESSION_IDLE_MINUTES=
# 大事な操作の前にパスワードを入れ直してから、入れ直さずに続けられる分（既定 10）
SUDO_WINDOW_MINUTES=
# アプリのログインが、使われないまま切れるまでの日数（既定 30）
TOKEN_IDLE_DAYS=
# アプリのログインが、必ず切れるまでの日数（既定 90。0 で無制限）
TOKEN_ABSOLUTE_DAYS=
# 要約などを Claude で行うときのモデル名（空なら既定のモデル）
ANTHROPIC_TEXT_MODEL=
# アシスタントで使うモデル名（空なら既定のモデル）
NL_AGENT_MODEL=
# リアルタイム調査のモデル。ふつうは空のまま（既定のモデルを使う）。費用や質を比べたいときだけ変える
# 統括役のモデル名（空なら claude-sonnet-5-5）
RESEARCH_ORCHESTRATOR_MODEL=
# 事実確認の調査役のモデル名（空なら claude-sonnet-5-5）
RESEARCH_FACTCHECK_MODEL=
# そのほかの調査役（補足情報・論理課題・技術情報）のモデル名（空なら claude-haiku-5-5）
RESEARCH_HAIKU_MODEL=
# 統括役の考える深さ。low・medium・high・max のどれか（空なら medium）。それ以外の値なら指定を送らない
RESEARCH_ORCHESTRATOR_EFFORT=
# true のときだけ、統括役も自分でウェブを検索する（空なら調査役に任せる）
RESEARCH_ORCHESTRATOR_WEB=
# 用語解説で、利用者ごとの用語の記録を見分けるための秘密の文字列（空なら SESSION_SECRET を使う）
TERM_HASH_SECRET=
# 外部のデータベースに暗号化して繋ぐときだけ true（Docker で立ち上げるときは不要）
DATABASE_SSL=
