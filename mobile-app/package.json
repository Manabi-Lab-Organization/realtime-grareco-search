{
  "name": "mobile-app",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run notices && tsc -b && vite build",
    "notices": "node ../scripts/third-party-notices.mjs --app . --out public/THIRD_PARTY_NOTICES.txt",
    "ios": "npm run build && npx cap sync ios",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "thirdPartyNotices": {
    "title": "Realtime GraReco & Search（iPhone アプリ）",
    "exclude": [
      "@capacitor/cli"
    ],
    "includeWithoutDeps": [
      "vite",
      "tailwindcss"
    ],
    "swiftPackages": {
      "resolved": "ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved",
      "licenseDir": "ios/native-licenses"
    }
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
